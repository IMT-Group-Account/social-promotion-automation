# Server-only BFF connection. Browser requests use /api/backend on the same origin.
BACKEND_API_URL=https://api.example.com/api
APP_ORIGIN=https://admin.example.com
# Application login provider; its access JWT must match backend SERVICE_JWT_* settings.
# JWT sub must be the application's UUID user ID. Never use an SNS token here.
AUTH_AUTHORIZATION_URL=
AUTH_TOKEN_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SCOPES=openid profile
AUTH_AUDIENCE=
# Public origin only, used to validate SNS OAuth popup messages. No tokens/secrets.
NEXT_PUBLIC_OAUTH_CALLBACK_ORIGIN=https://api.example.com
