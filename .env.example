# Server-only PostgreSQL connection; never expose this value or OAuth values to the frontend.
DATABASE_URL=

# Redis/BullMQ is server-only. Run this in a separate worker deployment after
# migration 009 is applied; API startup alone never publishes scheduled jobs.
REDIS_URL=
BULLMQ_PUBLISH_QUEUE_NAME=social-publish
PUBLISH_WORKER_ENABLED=false
PUBLISH_WORKER_CONCURRENCY=5
# Retry schedule is fixed: 30 seconds, 2 minutes, then 10 minutes.
# The fourth failure is final and creates an admin failure alert outbox row.
PUBLISH_WORKER_LEASE_MS=30000
PUBLISH_OUTBOX_POLL_INTERVAL_MS=5000

# Base64-encoded 32-byte AES-256 key. Generate and retain securely outside source control.
OAUTH_TOKEN_ENCRYPTION_KEY=
OAUTH_TOKEN_ENCRYPTION_KEY_VERSION=v1

# Public backend origin. Each exact callback must be registered in the corresponding provider console.
PUBLIC_API_ORIGIN=https://api.example.com
# Comma-separated browser origins allowed to call the API. This must include
# the Vercel frontend URL in production; never use a wildcard with credentials.
CORS_ORIGINS=https://admin.example.com

OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
OAUTH_LINKEDIN_AUTHORIZATION_URL=
OAUTH_LINKEDIN_TOKEN_URL=
OAUTH_LINKEDIN_PROFILE_URL=
OAUTH_LINKEDIN_SCOPES=

# LinkedIn REST Posts API: server-only configuration. Example values must be set
# from the currently supported LinkedIn API version in the provider documentation.
LINKEDIN_POSTS_URL=
LINKEDIN_API_VERSION=
# Optional analytics URL template, with {postUrn} placeholder URL-encoded by the adapter.
LINKEDIN_ANALYTICS_URL=

OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_AUTHORIZATION_URL=
OAUTH_FACEBOOK_TOKEN_URL=
OAUTH_FACEBOOK_PROFILE_URL=
OAUTH_FACEBOOK_SCOPES=
OAUTH_FACEBOOK_MANAGED_PAGES_URL=

# Graph API base URL must include the approved version, e.g. https://graph.facebook.com/vXX.X
FACEBOOK_GRAPH_API_BASE_URL=
# Optional analytics URL template with {postId}; page token remains server-only.
FACEBOOK_ANALYTICS_URL=

# Instagram Graph API requires a professional account linked to a managed Page.
INSTAGRAM_GRAPH_API_BASE_URL=
INSTAGRAM_CONTAINER_POLL_INTERVAL_MS=5000
INSTAGRAM_CONTAINER_MAX_ATTEMPTS=30
INSTAGRAM_ANALYTICS_URL=

# Threads OAuth and API use a separate Threads user identity and encrypted
# access token; do not reuse a Facebook Page or Instagram token.
OAUTH_THREADS_CLIENT_ID=
OAUTH_THREADS_CLIENT_SECRET=
OAUTH_THREADS_AUTHORIZATION_URL=
OAUTH_THREADS_TOKEN_URL=
OAUTH_THREADS_PROFILE_URL=
OAUTH_THREADS_SCOPES=
THREADS_GRAPH_API_BASE_URL=
THREADS_ANALYTICS_URL=

OAUTH_X_CLIENT_ID=
OAUTH_X_CLIENT_SECRET=
OAUTH_X_AUTHORIZATION_URL=
OAUTH_X_TOKEN_URL=
OAUTH_X_PROFILE_URL=
OAUTH_X_SCOPES=

# X API v2 server-only endpoints. OAuth scopes need tweet.read, tweet.write,
# and users.read. Approve only your managed storage host for binary media fetches.
X_API_BASE_URL=https://api.x.com
X_MEDIA_ALLOWED_HOSTS=
X_MEDIA_MAX_BYTES=

# Costs are integer micro-USD (1 USD = 1,000,000 micro-USD). Copy the current
# per-endpoint rates from the X Developer Console and give the snapshot a label.
X_API_PRICING_VERSION=
X_API_COST_POST_CREATE_MICRO_USD=
X_API_COST_POST_CREATE_WITH_URL_MICRO_USD=
X_API_COST_MEDIA_UPLOAD_MICRO_USD=
X_API_COST_POST_READ_MICRO_USD=
X_API_COST_POST_DELETE_MICRO_USD=
X_API_MAX_ESTIMATED_COST_MICRO_USD_PER_REQUEST=
# GET URL template containing {postId}; each analytics request is recorded as an X post read cost.
X_ANALYTICS_URL=

# Private key for the in-house chatbot/counselor integration bridge. This is
# not a browser key and is not a substitute for Kakao provider verification.
KAKAO_CHANNEL_INTEGRATION_KEY=

# Analytics collection is disabled until this interval is explicitly configured.
# One successful social_publish_job is claimed and snapshotted independently.
SCHEDULER_ENABLED=false
ANALYTICS_COLLECTION_INTERVAL_MS=
ANALYTICS_COLLECTION_STALE_AFTER_MS=3600000
ANALYTICS_COLLECTION_LEASE_MS=300000
ANALYTICS_COLLECTION_BATCH_SIZE=50
