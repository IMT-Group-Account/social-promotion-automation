# Copy this file to backend.env on the Oracle VM. Do not commit backend.env.
NODE_ENV=production
PORT=3000
PUBLIC_API_ORIGIN=https://api.example.com
CORS_ORIGINS=https://your-vercel-project.vercel.app

# Prefer private or TLS-protected managed service endpoints.
DATABASE_URL=postgres://USER:PASSWORD@POSTGRES_HOST:5432/social_promotion?sslmode=require
REDIS_URL=rediss://:PASSWORD@REDIS_HOST:6379

BULLMQ_PUBLISH_QUEUE_NAME=social-publish
PUBLISH_WORKER_CONCURRENCY=5
PUBLISH_WORKER_LEASE_MS=30000
PUBLISH_OUTBOX_POLL_INTERVAL_MS=5000

# Keep every still-required version here. New ciphertexts use the current
# version; an existing v1.<iv>.<tag>.<ciphertext> decrypts using the v1 key.
OAUTH_TOKEN_ENCRYPTION_KEY_VERSION=v2
OAUTH_TOKEN_ENCRYPTION_KEYS={"v1":"BASE64_OLD_KEY","v2":"BASE64_CURRENT_KEY"}
# Deprecated one-key fallback. Leave empty when the key ring is configured.
OAUTH_TOKEN_ENCRYPTION_KEY=

# Empty disables scheduled analytics collection. The scheduler container runs
# independently from the API and publishing worker.
ANALYTICS_COLLECTION_INTERVAL_MS=
ANALYTICS_COLLECTION_STALE_AFTER_MS=3600000
ANALYTICS_COLLECTION_LEASE_MS=300000
ANALYTICS_COLLECTION_BATCH_SIZE=50

# Copy all OAuth/provider/X/Kakao variables from the root .env.example here.
# They are server-only and must never be configured in Vercel's NEXT_PUBLIC_* variables.
