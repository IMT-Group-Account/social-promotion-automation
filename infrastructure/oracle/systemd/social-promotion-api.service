[Unit]
Description=Social Promotion API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=social-promotion
Group=social-promotion
WorkingDirectory=/opt/social-promotion/current
EnvironmentFile=/etc/social-promotion/backend.env
ExecStart=/usr/bin/node dist/src/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/social-promotion/uploads

[Install]
WantedBy=multi-user.target
